coverage/

# Logs & OS
*.log
.DS_Store

# Editor
.vscode/
.idea/

# Local tool artifacts (design-hook cache, etc.)
.impeccable/

# Vendor licensing material. The Ed25519 signing key mints licenses for every
# customer, and issued.jsonl is the only record of what was shipped — neither
# belongs in a repo that gets cloned onto build machines. The sole exceptions
# are the clearly-labelled test fixtures, which sign nothing real.
*.pem
!tools/license-generator/test/fixtures/test-signing-key.pem
*.lic
!tools/license-generator/test/fixtures/golden.lic
issued.jsonl

# Generated by scripts/verify-topology.mjs for the duration of a tier-2 run and
# removed in its `finally`. Ignored so a SIGINT mid-run cannot leave a stray
# compose file staged.
docker-compose.topology.yml
