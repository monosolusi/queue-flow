# Copy to `.env` beside docker-compose.yml. Compose reads it automatically.
#
# Only the vendor sets these. A store's mini PC receives the file already
# filled in, or takes the defaults below and pulls from a public registry.

# Where the published images live. `install.sh` pulls from here; the vendor's
# `npm run release` builds and pushes here.
QMS_REGISTRY=ghcr.io/monosolusi/qms

# The release to run. Pin an explicit version at a store — `latest` makes the
# next `docker compose pull` a surprise upgrade during business hours.
QMS_VERSION=latest

# --- Optional overrides ---------------------------------------------------
# Where activation keys are redeemed. The compiled-in default is correct for
# production; set this only to point at a staging activation server.
#
# It is NOT a security control and is not treated as one: whatever answers must
# still return a licence signed by a key compiled into the build, so pointing
# this somewhere hostile achieves nothing.
# QMS_LICENSE_ACTIVATION_URL=https://license.monosolusi.id/v1/activations
